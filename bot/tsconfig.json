{
  "compilerOptions": {
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "target": "es2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "baseUrl": "..",
    "paths": {
      "@server/*": ["server/src/*"]
    },
    "noImplicitAny": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*", "../src/api/**/*"]
}
